    "test:smoke-runner": "node --test scripts/android-uiautomator-smoke.test.mjs",
    "test:scaffold": "node scripts/validate-scaffold.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~54.0.34",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
