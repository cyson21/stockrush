    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.18",
    "jest-expo": "~54.0.13",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "shell-quote": "1.9.0",
    "tar": "7.5.19",
